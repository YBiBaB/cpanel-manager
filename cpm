#!/bin/bash

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
AUTOLOAD="$ROOT_DIR/vendor/autoload.php"


if [ ! -f "$AUTOLOAD" ]
then
    echo "[ERROR] Missing vendor/autoload.php."
    echo "Run composer install once in the project directory before starting CPM:"
    echo "  cd \"$ROOT_DIR\""
    echo "  composer install"
    exit 1
fi


if ! command -v php >/dev/null 2>&1
then
    echo "PHP CLI is required."
    exit 1
fi


PHP_VERSION=$(php -r 'echo PHP_MAJOR_VERSION;')


if [ "$PHP_VERSION" -lt 8 ]
then
    echo "PHP 8 or higher is required."
    exit 1
fi


php "$ROOT_DIR/bin/cpm.php"
